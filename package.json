{
  "name": "agentcss",
  "version": "0.19.0",
  "description": "移动 Web 组件库：CSS + 可选行为脚本，零第三方运行时依赖。样式用 bundler 引入，交互行为用 script 标签引入。",
  "keywords": [
    "css",
    "components",
    "mobile-web",
    "webview",
    "accessibility",
    "dark-mode",
    "rtl"
  ],
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "agentcss": "./ai/cli.js"
  },
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.html"
    },
    "./tokens.css": "./dist/01-tokens/tokens.css",
    "./typography.css": "./dist/01-tokens/typography.css",
    "./page.css": "./dist/01-tokens/page.css",
    "./esm": {
      "types": "./types/index.d.ts",
      "default": "./esm/index.mjs"
    },
    "./esm/*": "./esm/*.mjs",
    "./primitives/*": "./dist/02-primitives/*",
    "./patterns/*": "./dist/03-patterns/*",
    "./recipes/*": "./dist/04-recipes/*",
    "./assets/*": "./dist/09-assets/*",
    "./dist/*": "./dist/*",
    "./src/*": "./*",
    "./types": "./types/index.d.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "ai/",
    "!ai/surface.baseline.json",
    "adapters/",
    "!adapters/presentation/fixtures",
    "esm/",
    "types/",
    "dist/",
    "!dist/manifest.json",
    "01-tokens/",
    "02-primitives/",
    "03-patterns/",
    "04-recipes/",
    "09-assets/",
    "!09-assets/model-viewer/vendor",
    "!09-assets/model-viewer/models",
    "docs/",
    "README.md",
    "README.zh-CN.md",
    "START-HERE.md",
    "API.md",
    "SUPPORT.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "CHANGELOG.md",
    "LICENSE",
    "index.html"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.js",
    "**/*.mjs"
  ],
  "scripts": {
    "test": "node --test 05-audit/unit.test.mjs 05-audit/behavior-cores.test.mjs",
    "gate": "bash 05-audit/check-all.sh",
    "gate:fast": "bash 05-audit/check-all.sh --fast",
    "gate:timing": "bash 05-audit/check-all.sh --timing",
    "size:record": "python3 05-audit/size-baseline.py --record",
    "dist": "python3 05-audit/build-dist.py",
    "dist:check": "python3 05-audit/build-dist.py --check && node 05-audit/dist-parity-check.js && python3 05-audit/dist-cost-gate.py",
    "cost:update": "python3 05-audit/dist-cost-gate.py --update",
    "prefix": "python3 05-audit/prefix-build.py",
    "ai": "node ai/cli.js",
    "benchmark": "node benchmark/run.js",
    "test:types": "python3 05-audit/tsc-gate.py",
    "publish:check": "bash 05-audit/check-all.sh --fast && bash 05-audit/pack-smoke.sh",
    "prepublishOnly": "npm run publish:check"
  },
  "devDependencies": {
    "axe-core": "^4.10.0",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.49.1",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owain323/frontend-lib.git"
  },
  "keywords_note": "零依赖是本库的核心约束：安装它不会给使用者的 node_modules 增加任何一个包",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://owain323.github.io/frontend-lib/",
  "bugs": {
    "url": "https://github.com/owain323/frontend-lib/issues"
  }
}
