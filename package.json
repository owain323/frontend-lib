{
  "name": "frontend-lib",
  "version": "0.7.10",
  "description": "移动 Web 组件库：CSS + 可选行为脚本，零第三方运行时依赖。样式用 bundler 引入，交互行为用 script 标签引入。",
  "keywords": [
    "css",
    "components",
    "mobile-web",
    "webview",
    "accessibility",
    "dark-mode",
    "rtl"
  ],
  "license": "MIT",
  "type": "commonjs",
  "types": "./types/index.d.ts",
  "exports": {
    "./tokens.css": "./01-tokens/tokens.css",
    "./typography.css": "./01-tokens/typography.css",
    "./primitives/*": "./02-primitives/*",
    "./patterns/*": "./03-patterns/*",
    "./recipes/*": "./04-recipes/*",
    "./assets/*": "./09-assets/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "ai/",
    "adapters/",
    "types/",
    "dist/",
    "01-tokens/",
    "02-primitives/",
    "03-patterns/",
    "04-recipes/",
    "09-assets/",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "*.js"
  ],
  "scripts": {
    "test": "node --test 05-audit/unit.test.mjs",
    "gate": "bash 05-audit/check-all.sh",
    "gate:fast": "MODE=fast bash 05-audit/check-all.sh",
    "gate:timing": "TIMING=/tmp/gate-timing.txt bash 05-audit/check-all.sh",
    "size:record": "python3 05-audit/size-baseline.py --record",
    "dist": "python3 05-audit/build-dist.py",
    "dist:check": "python3 05-audit/build-dist.py --check && node 05-audit/dist-parity-check.js && python3 05-audit/dist-cost-gate.py",
    "cost:update": "python3 05-audit/dist-cost-gate.py --update",
    "prefix": "python3 05-audit/prefix-build.py",
    "ai": "node ai/cli.js",
    "benchmark": "node benchmark/run.js",
    "test:types": "python3 05-audit/tsc-gate.py"
  },
  "devDependencies": {
    "axe-core": "^4.10.0",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.49.1",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owain323/frontend-lib.git"
  },
  "keywords_note": "零依赖是本库的核心约束：安装它不会给使用者的 node_modules 增加任何一个包",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/owain323/frontend-lib",
  "bugs": {
    "url": "https://github.com/owain323/frontend-lib/issues"
  }
}
